# --- AWS (no keys here; credentials come from ~/.aws/credentials) ---
AWS_REGION=us-east-1

# --- Bedrock ---
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL_ID=us.amazon.nova-2-lite-v1:0

# --- OpenSearch (from: terraform output opensearch_endpoint) ---
OPENSEARCH_ENDPOINT=https://search-investor-intel-xxxxxxxxxxxxxxxxxxxxxxxxxx.us-east-1.es.amazonaws.com
OPENSEARCH_INDEX_NAME=investor-docs
OPENSEARCH_SERVICE=es

# --- Aurora (from: terraform output aurora_cluster_endpoint) ---
DB_HOST=aurorapostgresql.cluster-xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
